{
  "name": "prismoo",
  "version": "0.5.0",
  "description": "Prismoo · 跨平台透明桌面宠物 / Cross-platform desktop pet (Tauri 2 + Rust + TypeScript + Canvas)",
  "author": "Prismoo Contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "sprites": "node scripts/generate-sprites.mjs",
    "brand-icons": "node scripts/generate-brand-icons.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && npm run sprites && npm run brand-icons && tsc && node scripts/copy-assets.mjs && npm run tauri:resources",
    "tauri:resources": "node scripts/build-tauri-resources.mjs",
    "tauri:build": "cargo build --manifest-path src-tauri/Cargo.toml",
    "tauri:build:release": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "tauri:check": "npm run tauri:build && node scripts/run-tauri-check.mjs",
    "typecheck": "tsc --noEmit",
    "set-custom": "node scripts/set-custom.mjs",
    "verify-comments": "node scripts/verify-comments.mjs",
    "dist": "tauri build",
    "dist:win": "tauri build --bundles nsis",
    "dist:mac": "tauri build --bundles dmg,app",
    "dist:linux": "tauri build --bundles appimage,deb"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3"
  }
}
